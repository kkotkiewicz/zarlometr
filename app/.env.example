# Local firebase bypass, change to false when you want to use real firebase
VITE_NO_FIREBASE=true

# Firebase Web App config — skopiuj ten plik jako `app/.env` i uzupełnij
# wartościami z Firebase Console (Project settings → Your apps → SDK setup).
# TODO: utworzyć projekt w Firebase i wkleić wartości poniżej.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX). Gdy puste, używany jest
# domyślny ID z kodu. Patrz: Google Analytics → Admin → Data Streams.
VITE_GA_ID=

# Hotjar Site ID (liczba) — z Hotjar → Site Settings. Gdy puste, Hotjar jest wyłączony.
VITE_HOTJAR_ID=
